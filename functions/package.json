{
  "name": "hybridcloudworks-functions-azure",
  "description": "Azure Functions for HybridCloudWorks (migrated from Firebase Cloud Functions)",
  "version": "1.0.0",
  "type": "module",
  "main": "src/functions/index.js",
  "scripts": {
    "start": "func start",
    "build": "echo 'No build step required'",
    "test": "vitest run",
    "deploy": "echo \"Use the deploy-functions workflow, or: func azure functionapp publish $(terraform -chdir=../infra output -raw function_app_name)\" && exit 1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-pricing": "^3.1111.0",
    "@azure/cosmos": "^4.3.0",
    "@azure/functions": "^4.7.0",
    "@azure/identity": "^4.8.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/storage-blob": "^12.27.0",
    "cheerio": "^1.2.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  },
  "private": true,
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
