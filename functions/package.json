{
  "name": "hybridcloudworks-functions-azure",
  "description": "Azure Functions API and workers for the HybridCloudWorks website",
  "version": "1.0.0",
  "type": "module",
  "main": "src/functions/index.js",
  "scripts": {
    "start": "func start",
    "build": "echo 'No build step required'",
    "test": "vitest run",
    "deploy": "echo \"Use the deploy-functions workflow, or: func azure functionapp publish $(terraform -chdir=../infra output -raw function_app_name)\" && exit 1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-pricing": "^3.1115.0",
    "@azure/cosmos": "^4.3.0",
    "@azure/functions": "^4.7.0",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/storage-blob": "^12.27.0",
    "@breezystack/lamejs": "^1.2.7",
    "cheerio": "^1.2.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "private": true,
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
