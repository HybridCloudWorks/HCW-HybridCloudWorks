# Every version and checksum the hcw-lab image is built from, one per line.
#
# The Dockerfile copies this file in and sources it at the top of each RUN,
# so bumping a line here and pushing is the whole update procedure: CI
# rebuilds both targets, runs smoke.sh, and publishes. Nothing in the
# Dockerfile repeats a version, with one exception noted at DEBIAN_DIGEST.
#
# Every download is verified against the SHA256 beside it before it is used.
# The sums were resolved on 2026-09-25 from the publisher's own checksum file
# (releases.hashicorp.com SHA256SUMS, kubeconform CHECKSUMS, get.helm.sh
# .sha256sum, dl.k8s.io .sha256, PyPI's JSON API, the Terraform registry's
# download endpoint) and, for the GitHub source tarballs, computed locally
# from the downloaded archive. Values are plain shell assignments; the file is
# read by /bin/sh inside the build and must stay that way (no export, no
# expansions, no spaces around '=').

# Base image. The FROM lines in the Dockerfile carry this same digest, because
# a FROM cannot read a file; the publish workflow fails the build if the two
# disagree. Resolved from the registry's Docker-Content-Digest header (the
# method vps-agent/lib/capabilities.js documents) and cross-checked against
# the Docker Hub tags API, which reported the same value.
DEBIAN_TAG=bookworm-slim
DEBIAN_DIGEST=sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

# Tools in the runner target.
TERRAFORM_VERSION=1.16.4
TERRAFORM_SHA256=dc94af0eef1147718ad7c8daea792ed199e3e0492eec180d0adafa2a65a879df
KUBECONFORM_VERSION=0.8.0
KUBECONFORM_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
HELM_VERSION=4.3.0
HELM_SHA256=86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb
# ansible-core is the last 2.19 line because Debian bookworm ships Python
# 3.11 and 2.20+ requires 3.12. Installed from the pure-Python wheel into a
# venv that sees the Debian packages of its five dependencies.
ANSIBLE_CORE_VERSION=2.19.13
ANSIBLE_CORE_SHA256=d4a256d0891b3cb31ddbc9ff8a7bf6fd359379007799c54390b66b8f94fed3d3

# Tools added by the full target.
KUBECTL_VERSION=1.37.1
KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
# Debian package version string from packages.microsoft.com/repos/azure-cli
# (dists/bookworm/main/binary-amd64/Packages). The apt signing key is
# verified by SHA256 before it is trusted.
AZURE_CLI_VERSION='2.90.0-1~bookworm'
MICROSOFT_APT_KEY_SHA256=2fa9c05d591a1582a9aba276272478c262e95ad00acf60eaee1644d93941e3c6

# Terraform providers in the filesystem mirror at /opt/terraform/mirror, each
# with the SHA256 of its linux_amd64 zip as the registry reports it.
# azurerm is mirrored twice: 5.x is current, and the AVM pattern modules
# vendored below still constrain to ~> 4.0 / ~> 4.35. modtm and time are not
# in the issue's list but every vendored module requires them, so without
# them no vendored module could init offline.
PROVIDER_AZURERM_VERSION=5.7.0
PROVIDER_AZURERM_SHA256=871715c7c78678f155321e4b836aabc9a31cefd9ce5063a40b3f2e43dfb39f6f
PROVIDER_AZURERM_V4_VERSION=4.81.0
PROVIDER_AZURERM_V4_SHA256=79a8d17fefe647040fcb9ee8821a4f09f395427c4fd49493489b9a93a9a1038e
PROVIDER_AZAPI_VERSION=2.12.0
PROVIDER_AZAPI_SHA256=71402acfa1ad35788a5d1669bdd59040434a45aea990d062dcc41f17163c8e1b
PROVIDER_ALZ_VERSION=0.22.0
PROVIDER_ALZ_SHA256=91e88646e140a728de20c8f66c5fb9e56c240e7c0eab3c1e0f127932c2418fba
PROVIDER_RANDOM_VERSION=3.9.1
PROVIDER_RANDOM_SHA256=60b4f8a8ef18f52bf8e19215229dae408bee732825964092db7c989fd2de4097
PROVIDER_MODTM_VERSION=0.4.0
PROVIDER_MODTM_SHA256=6968bbd28ccdeefa33a77393e1695a896b02e6eeab6ca3384a371675e86587f4
PROVIDER_TIME_VERSION=0.14.2
PROVIDER_TIME_SHA256=0aa1028d91041f4dceba193e3707dac57358d0063d97e20700e554758b67baca

# Azure Verified Modules vendored at /opt/avm/<name>@<version>, from the
# GitHub release source tarball of each repository (Azure/terraform-azurerm-
# <name>, tag v<version>). The SHA256 is of the tarball.
#
# The fourth module the issue names, avm-ptn-alz-application-landing-zone-
# identity-and-access, is not vendored: on 2026-09-25 its repository had no
# release and no tag, and its main branch was still the unmodified AVM
# template (README title "terraform-azurerm-avm-template", a resource named
# azurerm_resource_group.TODO). Add it here when a release exists.
AVM_PTN_ALZ_VERSION=0.21.0
AVM_PTN_ALZ_SHA256=eb2429bfbf4ec5a76b28ffa757ae6ff29e34ea7a84831a9a318809307ca698d8
AVM_PTN_ALZ_MANAGEMENT_VERSION=0.9.0
AVM_PTN_ALZ_MANAGEMENT_SHA256=0536d6050df25ebb53f0f562b8dba5db7264f5323dc333167098a1b743c7281b
AVM_PTN_ALZ_CONNECTIVITY_HUB_AND_SPOKE_VNET_VERSION=0.17.5
AVM_PTN_ALZ_CONNECTIVITY_HUB_AND_SPOKE_VNET_SHA256=dcfa905c0ce4885c29431f644411069dcdfa3d5fc008954a5389815f48239519

# The registry modules those three call, transitively, vendored beside them by
# vendor-avm.sh (#675) and pinned one per line as `<name>@<version> <hash>`.
# The version is what the pattern module's constraint resolved to on
# 2026-09-25 (the registry pins each to a commit, so the same constraint
# resolves the same until the pattern module is bumped). The hash is of the
# vendored tree after pruning examples, tests and every dot-prefixed entry:
#   find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum
# run inside /opt/avm/<name>@<version>. The build fails on a mismatch, on a
# child it vendored that is missing here, and on a line here nothing calls;
# to refresh the list after a pattern-module bump, print it with
#   docker build --target vendor --build-arg AVM_PRINT_PINS=1 --progress=plain lab-image
# and paste the AVM_CHILD_MODULES block it prints over this one.
AVM_CHILD_MODULES='
avm-ptn-network-private-link-private-dns-zones@0.23.2 a04f68ea7afce4a8fd71a41443ae5adbe4c999d6e8de8b1edea5cea92567db15
avm-res-network-azurefirewall@0.4.0 d2d73c553d85227d5cef9f6648c8b08e3d274d1f050a6fcac450cac11c784b20
avm-res-network-bastionhost@0.6.0 52bb44e545947b32e9cf0fc8471751310b5d632c1d9ca3915c7eb10c565353ac
avm-res-network-ddosprotectionplan@0.3.0 2da2f4a4209214ee1fb939fc85e370770f4a0b02955b1c9c544bf14ef13ab95a
