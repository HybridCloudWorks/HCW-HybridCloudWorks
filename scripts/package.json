{
  "name": "hybridcloudworks-migration-scripts",
  "description": "Firestore → Cosmos DB and Firebase Storage → Blob data migration tooling for the Site-Main migration",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "preflight": "node preflight-firestore-inventory.mjs",
    "probe": "node migration-probe.mjs",
    "export": "node migrate-firestore-to-cosmos.mjs --export",
    "import:dry": "node migrate-firestore-to-cosmos.mjs --import --dry-run",
    "import": "node migrate-firestore-to-cosmos.mjs --import",
    "verify": "node verify-migration.mjs",
    "storage:inventory": "node migrate-storage-to-blob.mjs --inventory",
    "storage:copy:dry": "node migrate-storage-to-blob.mjs --copy --dry-run",
    "storage:copy": "node migrate-storage-to-blob.mjs --copy",
    "storage:verify": "node migrate-storage-to-blob.mjs --verify",
    "spec:check": "node generate-cosmos-container-spec.mjs --check",
    "test": "vitest run",
    "smoke:deployed": "node smoke-deployed.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/cosmos": "^4.3.0",
    "@azure/identity": "^4.8.0",
    "@azure/storage-blob": "^12.27.0",
    "@google-cloud/storage": "^7.21.0",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "gaxios": "^7.1.5",
    "retry-request": "^8.0.3",
    "teeny-request": "^10.1.3",
    "uuid": "^11.1.1"
  }
}
