# {{ ansible_managed }}
[Unit]
Description=Run {{ coder_backup_unit_name }}.service nightly

[Timer]
OnCalendar={{ coder_backup_on_calendar }}
# A missed run (host was off at 03:30) runs at the next boot instead of being
# skipped; the jitter keeps it off the unattended-upgrades reboot at 04:30.
Persistent=true
RandomizedDelaySec=10m
Unit={{ coder_backup_unit_name }}.service

[Install]
WantedBy=timers.target
