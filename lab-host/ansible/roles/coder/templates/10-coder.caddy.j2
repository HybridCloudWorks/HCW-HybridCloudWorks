# {{ ansible_managed }}
# Imported inside the wildcard site block of /etc/caddy/Caddyfile, so TLS and
# the certificate are the site's. Coder's dashboard is coder.lab and its
# workspace apps are one label below (CODER_WILDCARD_ACCESS_URL), which is
# why the matcher names both. reverse_proxy passes WebSockets through and
# sets X-Forwarded-For, X-Forwarded-Proto and X-Forwarded-Host, which
# docker-compose.yml tells Coder to trust from the Compose network's gateway.
#
# Panes only (owner decision 2026-09-28). The Caddyfile's lab_panes_only
# covers these names like every other, and runs before the routes below. A
# top-level visit goes to the site's labs page, and every response carries
# the site-only frame-ancestors. Coder then needs two things to work under
# it, both in this file, and the lab launcher between them opens the editor
# inside the pane.
@coder host {{ coder_domain }} *.{{ coder_domain }}

# 1. GitHub sign-in is the one Coder request that must work at the top
#    level. github.com refuses to be framed, so sign-in cannot run inside a
#    pane, and the site opens it in a window of its own. This path shows no
#    page at the top level. Going out, it redirects to GitHub. Coming back,
#    it sets the session and redirects into Coder, and that redirect is
#    itself a top-level visit, which lab_panes_only sends to the labs page.
#    The panes there are then signed in. The exemption is for the dashboard
#    name only, never a workspace app name.
@coder_github_sign_in {
  host {{ coder_domain }}
  path /api/v2/users/oauth2/github/callback
}
vars @coder_github_sign_in lab_top_level_allowed true

# The lab launcher, which the site's panes load instead of a Coder page
# (lab-host/coder/launcher/, installed by the coder role). Coder's dashboard
# opens code-server in a new window or tab, a top-level visit that
# lab_panes_only sends away, so the editor could never open in a pane from
# there. The launcher reads the learner's workspace with their own session
# (GET only, same origin), and replaces itself with code-server's own name
# once it is healthy. It is on the dashboard name because that is where the
# session cookie and the API are. It gets no top-level exemption: opened in
# a tab, it is redirected like any other Coder page.
# Its policy is added beside lab_panes_only's frame-ancestors, not in place
# of it, so the framing rule stays the Caddyfile's alone and the browser
# enforces both. Scripts, styles, fetches and frames from this name only,
# and nothing inline. This handle comes before handle @coder, so these
# paths never reach Coder; handle blocks with matchers keep the order they
# are written in (`caddy adapt` shows this route's subroute first). A file
# that is not there is an error, which handle_errors below answers with the
# same 503 sentence as Coder stopped, and the pane says the workspaces are
# unavailable.
@coder_lab_launcher {
  host {{ coder_domain }}
  path /_hcw/lab/*
}
handle @coder_lab_launcher {
  header {
    +Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; frame-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'"
    Cache-Control "no-store"
    X-Content-Type-Options "nosniff"
  }
  uri strip_prefix /_hcw/lab
  root * {{ coder_launcher_dir }}
  file_server
}

handle @coder {
  # 2. Coder's pages send their own Content-Security-Policy. Its default
  #    frame-ancestors 'self' (coderd/httpmw/csp.go, v2.37.3) would keep
  #    them out of the site's panes, because a browser enforces every
  #    policy it receives. This removes that one directive as the response
  #    is written and leaves the rest of Coder's policy as it is, so the
  #    Caddyfile's frame-ancestors is the one that decides. Only the default
  #    is matched: Coder's OAuth2 consent page sends frame-ancestors 'none'
  #    and keeps it. Coder writes each directive as "<name> <values>; " in
  #    an order that changes from one response to the next, and the last
  #    one has no trailing space. So the find, which Caddy reads as a
  #    regular expression, makes the space optional. With it required, 7 of
  #    40 pane loads of /login on v2.37.3 kept Coder's frame-ancestors
  #    'self' (measured 2026-09-28), and a browser would have refused to
  #    show those in the pane.
  header >Content-Security-Policy "frame-ancestors 'self'; ?" ""
  reverse_proxy 127.0.0.1:{{ coder_http_port }}
}

# When the coder Compose service is stopped (the everyone-at-once kill
# switch in ADR 0032), the proxy cannot dial and Caddy would answer 502.
# Answer 503 with a sentence instead, so the state is legible from outside.
handle_errors {
  @coder_down host {{ coder_domain }} *.{{ coder_domain }}
  handle @coder_down {
    respond "{{ coder_unavailable_response }}" 503
  }
}
