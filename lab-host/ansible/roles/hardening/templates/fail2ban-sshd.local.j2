# {{ ansible_managed }}
# The systemd backend reads sshd's journal directly, so the jail does not
# depend on rsyslog writing /var/log/auth.log, on Ubuntu 26.04 or 24.04.
[sshd]
enabled = true
backend = systemd
mode = aggressive
maxretry = {{ hardening_fail2ban_maxretry }}
findtime = {{ hardening_fail2ban_findtime }}
bantime = {{ hardening_fail2ban_bantime }}
