#!/usr/bin/env bash
# hcw-vault-set KEY  (value on stdin)
# Sets one key in the lab host's Ansible vault without printing any value.
# The value comes on stdin so it never appears in argv, a shell history or a log.
set -euo pipefail
key="${1:?usage: hcw-vault-set <vault_key>   (the value is read from stdin)}"
[[ "$key" =~ ^vault_[a-z0-9_]+$ ]] || { echo "hcw-vault-set: refusing key name '$key' (expected vault_[a-z0-9_]+)" >&2; exit 2; }
dir="${HCW_VAULT_DIR:-/etc/hcw/ansible}"
src="${HCW_SRC_DIR:-/opt/hcw-src}"
vault="$dir/vault.yml"
pass="$dir/vault-password"
next="$dir/.vault.yml.hcw-vault-set.$$"
py=/opt/uv/tools/ansible-core/bin/python
av=/usr/local/bin/ansible-vault
# bootstrap.sh passes vault.yml with -e, and an extra var outranks every other
# variable, so a key the playbook also defines would silently replace it:
# vault_enabled or vault_api_port, say, which belong to the role that runs
# HashiCorp Vault. The playbook the host runs is the checkout bootstrap.sh
# keeps at /opt/hcw-src, read now rather than a list kept here.
"$py" - "$src" "$key" <<'PY' || exit 2
import pathlib, sys, yaml
src, key = pathlib.Path(sys.argv[1]), sys.argv[2]
ansible = src / "lab-host" / "ansible"
def refuse(why):
    print(f"hcw-vault-set: refusing key name '{key}': {why}; nothing changed", file=sys.stderr)
    sys.exit(2)
def load(path):
    try:
        return yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, yaml.YAMLError) as error:
        refuse(f"cannot read {path} to check it ({type(error).__name__})")
def tasks(node):
    if isinstance(node, list):
        for item in node:
            yield from tasks(item)
    elif isinstance(node, dict):
        yield node
        for nested in ("block", "rescue", "always"):
            yield from tasks(node.get(nested))
group_vars = ansible / "group_vars" / "all.yml"
if not group_vars.is_file():
    refuse(f"cannot check it against the playbook, because there is no checkout at {src}")
override = "and vault.yml is passed with -e, so the key would override that variable"
# Top-level variables: group_vars, and every role's defaults and vars.
for path in [group_vars, *sorted(ansible.glob("roles/*/defaults/main.yml")), *sorted(ansible.glob("roles/*/vars/main.yml"))]:
    data = load(path)
    if isinstance(data, dict) and key in data:
        refuse(f"{path.relative_to(src)} defines it, {override}")
# Variables a task sets: register and set_fact.
for path in sorted(ansible.glob("roles/*/tasks/*.yml")):
    for task in tasks(load(path)):
        facts = task.get("ansible.builtin.set_fact", task.get("set_fact"))
        if task.get("register") == key or (isinstance(facts, dict) and key in facts):
            refuse(f"a task in {path.relative_to(src)} sets it, {override}")
PY
[ -s "$pass" ] || { echo "hcw-vault-set: no vault password at $pass" >&2; exit 2; }
tmp="$(mktemp -d)"; chmod 700 "$tmp"
cleanup() { find "$tmp" -type f -exec shred -u {} + 2>/dev/null || true; rm -rf "$tmp"; rm -f "$next"; }
trap cleanup EXIT
umask 077
tr -d '\r' > "$tmp/value"
if [ -f "$vault" ]; then "$av" view --vault-password-file "$pass" "$vault" > "$tmp/plain"; else : > "$tmp/plain"; fi
"$py" - "$tmp/plain" "$tmp/value" "$key" <<'PY'
import sys, yaml
plain, value_file, key = sys.argv[1:4]
# utf-8-sig: a leading byte order mark, which Windows tools can put on piped
# text, is not part of the value, and strip() would keep it.
value = open(value_file, encoding="utf-8-sig").read().strip()
if not value:
    raise SystemExit("hcw-vault-set: the value on stdin was empty; nothing changed")
data = yaml.safe_load(open(plain, encoding="utf-8")) or {}
if not isinstance(data, dict):
    raise SystemExit("hcw-vault-set: the vault is not a key/value mapping; nothing changed")
data[key] = value
with open(plain, "w", encoding="utf-8") as fh:
    yaml.safe_dump(data, fh, default_flow_style=False, sort_keys=True)
PY
"$av" encrypt --vault-password-file "$pass" --output "$tmp/new" "$tmp/plain" >/dev/null 2>&1
"$av" view --vault-password-file "$pass" "$tmp/new" | "$py" -c "import sys,yaml; d=yaml.safe_load(sys.stdin); assert isinstance(d,dict) and d.get(sys.argv[1]), 'verify failed'" "$key"
# Written beside the vault and renamed over it, so vault.yml is always the old
# file or the new one. install alone unlinks vault.yml before it writes the
# copy, and a run that stopped in between (a full disk) would lose the vault.
install -m 0600 -o root -g root "$tmp/new" "$next"
mv -f "$next" "$vault"
names="$("$av" view --vault-password-file "$pass" "$vault" | "$py" -c "import sys,yaml; print(', '.join(sorted(yaml.safe_load(sys.stdin))))")"
echo "hcw-vault-set: set $key (value not shown). Keys in the vault: $names"
