# {{ ansible_managed }}
[Unit]
Description=HCW Labs VPS agent (vps-agent)
Documentation=https://github.com/HybridCloudWorks/HCW-HybridCloudWorks/tree/main/vps-agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ labs_agent_user }}
Group={{ labs_agent_group }}
WorkingDirectory={{ labs_agent_app_dir }}
EnvironmentFile={{ labs_agent_env_file }}
Environment=NODE_ENV=production
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
