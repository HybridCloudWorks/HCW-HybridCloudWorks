# {{ ansible_managed }}
[Unit]
Description=HCW Labs VPS agent (vps-agent)
# When Restart= gives up, say so where Azure can hear it (LAB-2).
OnFailure=hcw-unit-failed@%n.service
Documentation=https://github.com/HybridCloudWorks/HCW-HybridCloudWorks/tree/main/vps-agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ labs_agent_user }}
Group={{ labs_agent_group }}
WorkingDirectory={{ labs_agent_app_dir }}
EnvironmentFile={{ labs_agent_env_file }}
Environment=NODE_ENV=production
# lib/docker-runner.js stages each payload under os.tmpdir() and bind-mounts
# it into the job container. PrivateTmp below gives this unit a /tmp the
# Docker daemon cannot see, so TMPDIR points at a real host directory instead.
Environment=TMPDIR={{ labs_agent_tmp_dir }}
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Added 2026-10-06 (LAB-5): the agent is a Node process that spawns the
# docker CLI, which needs AF_UNIX for the socket and AF_INET/AF_INET6 for the
# API; nothing else. @system-service is the systemd set a service needs;
# the rest closes kernel tunables, modules, cgroups, setuid and realtime.
# MemoryDenyWriteExecute is deliberately NOT set: V8 JIT needs W^X memory.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
