.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. The azurerm pin is `~> 4.0`,
# so without a committed lock CI resolves a different provider version than a
# developer does, and a provider minor release changes the plan under you.
*.enc.yaml
keys.txt

# Local exports and reports are never part of the website source tree.
export/
reports/
**/firebase-service-account.json

# Bootstrap run reports — hold real subscription and client ids.
# REVIEW.md keeps real values out of tracked files; this is not an exception.
scripts/.reports/

# Editor workspace settings — machine-local, not a repository contract.
.vscode/
