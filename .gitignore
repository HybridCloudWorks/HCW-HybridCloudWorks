node_modules/
dist/
.env
*.pem
*.p12
*.pfx
*.key
**/serviceAccountKey.json
**/firebase-sa.json
**/kubeconfig
**/kubeconfig.*
.funcignore
local.settings.json
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. The azurerm pin is `~> 4.0`,
# so without a committed lock CI resolves a different provider version than a
# developer does, and a provider minor release changes the plan under you.
*.enc.yaml
keys.txt

# Local exports and reports are never part of the website source tree.
export/
reports/
**/firebase-service-account.json

# Bootstrap run reports — hold real subscription and client ids.
# REVIEW.md keeps real values out of tracked files; this is not an exception.
scripts/.reports/

# Agentic orchestration run state - per-run local workflow JSON, handoffs, and
# the append-only session audit log. Regenerated by tooling/workflow.py; never
# a repository contract and it records local machine paths.
.agentic/

# MkDocs build output (docs-pages.yml uploads it as the Pages artifact).
site/
