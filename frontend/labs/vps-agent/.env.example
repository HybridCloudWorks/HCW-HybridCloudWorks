# HCW Labs VPS Agent configuration
# Copy to .env (or set in the systemd unit) on the Hostinger VPS.

# REQUIRED — absolute path to the scoped Firebase service account JSON.
# Create a dedicated service account with ONLY Firestore access (see README).
LABS_AGENT_SERVICE_ACCOUNT=/opt/hcw-labs-agent/service-account.json

# Stable agent identity (defaults to hostname). Becomes the lab_agents doc ID.
LABS_AGENT_ID=hostinger-vps-1

# Comma-separated capability subset to advertise (default: all in lib/capabilities.js)
LABS_AGENT_CAPABILITIES=shell-echo,terraform-validate,ansible-check

# Concurrency + polling fallback interval (ms)
LABS_AGENT_MAX_CONCURRENT=1
LABS_AGENT_POLL_MS=15000

# Per-job Docker sandbox limits
LABS_AGENT_JOB_MEMORY=256m
LABS_AGENT_JOB_CPUS=0.5
LABS_AGENT_JOB_PIDS=128
