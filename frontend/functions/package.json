{
  "name": "hybridcloudworks-functions",
  "description": "Cloud Functions for Personal Site - HybridCloudWorks",
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "readiness:local": "node --env-file=.env check-ai-stack-readiness.js",
    "readiness:remote": "node check-ai-stack-readiness.js --remote --project hybridcloudworks-61e8d --region us-central1",
    "readiness:remote:auto": "node ..\\scripts\\check-ai-stack-readiness-live.mjs",
    "scrape:benchmark": "node test-scrape-fallback.js --urls-file ./scrape-benchmark-urls.txt",
    "scrape:benchmark:local": "node test-scrape-fallback.js --local --urls-file ./scrape-benchmark-urls.txt"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@mendable/firecrawl-js": "^4.32.0",
    "@notionhq/client": "^5.23.3",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.7.0",
    "replicate": "^1.4.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4"
  },
  "private": true,
  "overrides": {
    "gaxios": "^7.1.5",
    "retry-request": "^8.0.3",
    "teeny-request": "^10.1.3",
    "uuid": "^11.1.1"
  }
}
