{
  "name": "web-app",
  "type": "module",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:data": "node scripts/generate-public-data.cjs",
    "data:update:applied-skills": "node scripts/update-applied-skills.mjs",
    "data:update:credentials": "node scripts/update-applied-skills.mjs",
    "preview": "vite preview",
    "lint": "eslint src functions --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src functions --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "validate:routes": "node scripts/validate-routes.js",
    "validate:providers": "node scripts/validate-provider-pages.js",
    "validate:content-matrix": "node scripts/validate-content-matrix.cjs",
    "code:quality": "npm run lint && npm run format:check && npm run validate:routes && npm run validate:providers && npm run validate:content-matrix",
    "code:fix": "npm run lint:fix && npm run format",
    "a11y:check-keyboard": "node scripts/validate-keyboard-nav.js",
    "a11y:contrast": "node scripts/axe-theme-scan.mjs",
    "a11y:contrast:report": "node scripts/axe-report-summary.mjs",
    "a11y:contrast:e2e": "playwright test contrast.spec.js",
    "a11y:audit": "npm run a11y:check-keyboard && npm run a11y:contrast",
    "a11y:fix-high-safety": "node scripts/high-safety-fixes.js",
    "a11y:fix-inputs": "node scripts/high-safety-input-fixes.js",
    "clean": "node -e \"const fs=require('fs');const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('dist');rm('node_modules/.vite');\"",
    "clean:all": "node -e \"const fs=require('fs');const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('dist');rm('node_modules');\"",
    "test": "vitest",
    "test:admin": "vitest run src/lib/contentImages.test.js src/lib/csp.test.js src/lib/dateUtils.test.js src/lib/functionsBase.test.js src/lib/labsPolling.test.js src/pages/admin/DashboardPage.test.jsx src/pages/admin/QueuePage.test.jsx src/pages/admin/OpsHealthPage.test.jsx functions/cms-functions.test.js",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "verify:required": "npm run build && npm run test:admin",
    "verify:optional:release": "npm run test:e2e",
    "smoke:auth:capture": "node scripts/capture-admin-storage-state-edge.mjs",
    "smoke:auth:capture:cdp": "node scripts/capture-admin-storage-state-from-edge-cdp.mjs",
    "smoke:priority2:edge": "node scripts/run-priority2-smoke-edge.mjs",
    "smoke:priority2:flow": "node scripts/run-priority2-smoke-edge-flow.mjs",
    "smoke:priority2:manual-login": "node scripts/run-priority2-smoke-with-manual-edge-login.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.3",
    "@azure/msal-react": "^5.5.4",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tailwindcss/postcss": "^4.3.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-big-calendar": "^1.19.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "react-zoom-pan-pinch": "^4.0.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.11.9",
    "commitlint": "^21.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.25",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "@opentelemetry/core": "2.8.0",
    "brace-expansion": "5.0.9",
    "uuid": "^11.0.0",
    "node-domexception": "^2.0.2",
    "debug": "^4.3.7",
    "highlight.js": "^11.9.0",
    "prismjs": "^1.30.0",
    "minimatch": "^10.2.2",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "archiver": "^7.0.1",
    "readdir-glob": "^3.0.0",
    "ajv": "^8.18.0",
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    },
    "eslint": {
      "ajv": "6.14.0"
    },
    "hono": "^4.12.34",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "node node_modules/eslint/bin/eslint.js --fix",
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ]
  }
}
