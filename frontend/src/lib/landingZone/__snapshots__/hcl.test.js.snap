exports[`emitFiles > matches the committed snapshot of the default build > providers.tf 1`] = `
"# The default providers take the tenant, subscription and credentials from the
# ARM_TENANT_ID, ARM_SUBSCRIPTION_ID, ARM_CLIENT_ID and ARM_CLIENT_SECRET variables
# of the HCP Terraform workspace. The aliases below point each module at the
# subscription it deploys into, which is how a landing zone keeps management,
# connectivity, identity and every application apart.
provider "azurerm" {
  features {}
}

provider "azapi" {}

# The alz provider reads the "alz" architecture (the management group tree and
# the policy baseline) from this release of the Azure Landing Zones library.
provider "alz" {
  library_references = [{
    path = "platform/alz"
    ref  = "2026.08.1"
  }]
}

provider "azurerm" {
  alias           = "management"
  subscription_id = var.subscription_id_management
  features {}
}

provider "azapi" {
  alias           = "management"
  subscription_id = var.subscription_id_management
}

provider "azurerm" {
  alias           = "connectivity"
  subscription_id = var.subscription_id_connectivity
  features {}
}

provider "azapi" {
  alias           = "connectivity"
  subscription_id = var.subscription_id_connectivity
}

provider "azurerm" {
  alias           = "identity"
  subscription_id = var.subscription_id_identity
  features {}
}

provider "azurerm" {
  alias           = "corp_1"
  subscription_id = var.subscription_ids_corp[0]
  features {}
}

provider "azurerm" {
  alias           = "online_1"
  subscription_id = var.subscription_ids_online[0]
  features {}
}
"
`;

exports[`emitFiles > matches the committed snapshot of the default build > terraform.tf 1`] = `
"# Generated by the HybridCloudWorks Landing Zone Builder for learning. Never applied here.
terraform {
  required_version = ">= 1.12, < 2.0"

  required_providers {
    alz = {
      source  = "azure/alz"
      version = "~> 0.21"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.12"
    }
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.35"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
"
`;

exports[`emitFiles > matches the committed snapshot of the default build > terraform.tfvars.example 1`] = `
"# Copy to terraform.tfvars and replace every all-zero GUID with a real subscription id.
location                     = "centralus"
root_management_group_id     = "alz"
hub_address_space            = "10.0.0.0/16"
subscription_id_management   = "00000000-0000-0000-0000-000000000000"
subscription_id_connectivity = "00000000-0000-0000-0000-000000000000"
subscription_id_identity     = "00000000-0000-0000-0000-000000000000"
subscription_ids_corp        = ["00000000-0000-0000-0000-000000000000"]
subscription_ids_online      = ["00000000-0000-0000-0000-000000000000"]
"
`;

exports[`emitFiles > matches the committed snapshot of the default build > variables.tf 1`] = `
"variable "location" {
  type        = string
  default     = "centralus"
  description = "The Azure region for every regional resource."
}

variable "enable_telemetry" {
  type        = bool
  default     = true
  description = "Whether the Azure Verified Modules send their usage telemetry to Microsoft."
}

variable "root_management_group_id" {
  type        = string
  default     = "alz"
  description = "The id of the management group at the top of the landing zone tree."
}

variable "hub_address_space" {
  type        = string
  default     = "10.0.0.0/16"
  description = "The IPv4 address space of the hub virtual network."
}

variable "subscription_id_management" {
  type        = string
  description = "The management subscription."

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$", var.subscription_id_management))
    error_message = "A subscription id is a GUID."
  }
}

variable "subscription_id_connectivity" {
  type        = string
  description = "The connectivity subscription."

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$", var.subscription_id_connectivity))
    error_message = "A subscription id is a GUID."
  }
}

variable "subscription_id_identity" {
  type        = string
  description = "The identity subscription."

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$", var.subscription_id_identity))
    error_message = "A subscription id is a GUID."
  }
}

variable "subscription_ids_corp" {
  type        = list(string)
  description = "The corp landing zone subscriptions, one per landing zone."

  validation {
    condition     = length(var.subscription_ids_corp) == 1 && alltrue([for id in var.subscription_ids_corp : can(regex("^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$", id))])
    error_message = "Exactly 1 subscription id, each a GUID."
  }
}

variable "subscription_ids_online" {
  type        = list(string)
  description = "The online landing zone subscriptions, one per landing zone."

  validation {
    condition     = length(var.subscription_ids_online) == 1 && alltrue([for id in var.subscription_ids_online : can(regex("^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$", id))])
    error_message = "Exactly 1 subscription id, each a GUID."
  }
}
"
`;
