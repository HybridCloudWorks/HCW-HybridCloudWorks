# Example environment variables for local development
# Copy this file to `.env` and replace placeholder values before running.
#
# Everything prefixed with VITE_ is baked into the public browser bundle.
# Never put a secret here — no keys, no connection strings, no tokens.

# API base URL — the only backend configuration the browser needs.
# Resolved by src/lib/functionsBase.js; nothing else may read it directly.
#
# The value must include the Azure Functions route prefix (`api`), because
# every route is registered relative to it: `public/content` is served at
# <host>/api/public/content.
#
#   Same-origin  (Static Web Apps linked backend, or a reverse proxy):
#     VITE_AZURE_FUNCTIONS_URL=/api
#   Cross-origin (Function App on its own hostname):
#     VITE_AZURE_FUNCTIONS_URL=https://REPLACE_ME.azurewebsites.net/api
VITE_AZURE_FUNCTIONS_URL=/api

# Azure Entra ID (MSAL) configuration — public client registration values.
VITE_ENTRA_CLIENT_ID=REPLACE_ME_WITH_CLIENT_ID
VITE_ENTRA_TENANT_ID=REPLACE_ME_WITH_TENANT_ID_OR_COMMON

# Scope requested for the API access token. Its audience must match the
# Functions app's ENTRA_API_AUDIENCE or every authenticated call returns 401.
VITE_ENTRA_API_SCOPE=api://REPLACE_ME_WITH_API_CLIENT_ID/.default

# Social profile URLs — leave blank to hide icons in the footer
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_GITHUB_URL=

# Cosmos DB is deliberately absent. The browser must never instantiate a
# Cosmos data-plane client or receive a Cosmos key (.azure/api-surface.json →
# meta.constraint); all data reaches the browser through Azure Functions.
# Do not reintroduce VITE_COSMOS_ENDPOINT / VITE_COSMOS_READ_KEY.

# Admin access is granted by the Entra 'Admin' App Role plus an admins/{oid}
# registry document in Cosmos — not by a build-time variable. There is no
# VITE_OWNER_ADMIN_* equivalent.

# Server-side integration secrets (Publer, Linktree, Klaviyo) live in Azure
# Key Vault and are read only by the Functions app. Never add VITE_PUBLER_*,
# VITE_LINKTREE_* or VITE_KLAVIYO_* vars.
