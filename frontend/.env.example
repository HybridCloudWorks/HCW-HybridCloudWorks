# Example environment variables for local development
# Copy this file to `.env` and replace placeholder values before running.

# Azure Entra ID (MSAL) configuration
VITE_ENTRA_CLIENT_ID=REPLACE_ME_WITH_CLIENT_ID
VITE_ENTRA_TENANT_ID=REPLACE_ME_WITH_TENANT_ID_OR_COMMON

# Optional: URL for callable cloud functions
VITE_GCP_FUNCTIONS_URL=https://us-central1-hybridcloudworks-61e8d.cloudfunctions.net

# Backend Provider — set to 'azure' to switch from Firebase to Azure backend
# VITE_BACKEND_PROVIDER=azure

# Azure Configuration (required when VITE_BACKEND_PROVIDER=azure)
VITE_AZURE_FUNCTIONS_URL=https://hcw-functions-prod.azurewebsites.net
VITE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
VITE_COSMOS_READ_KEY=REPLACE_ME_WITH_READ_ONLY_KEY
VITE_COSMOS_DATABASE=hybridcloudworks

# Admin identity — required for admin portal access. Never hardcode in source.
# Get UID from Firebase Console → Authentication → Users
VITE_OWNER_ADMIN_EMAIL=REPLACE_ME
VITE_OWNER_ADMIN_UID=REPLACE_ME

# Social profile URLs — leave blank to hide icons in the footer
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_GITHUB_URL=

# NOTE: If you switch to a different custom auth subdomain (e.g. auth.hybridcloudworks.com)
# update `VITE_FIREBASE_AUTH_DOMAIN` accordingly and ensure the domain is verified in
# Google Search Console and added to Firebase Hosting.

# Social integrations (admin portal — Amplify section)
# Publer credentials live in Google Secret Manager only (used server-side by the
# `publerProxy` Cloud Function). Never add VITE_PUBLER_* vars — anything prefixed
# with VITE_ is baked into the public browser bundle.

# Linktree (admin portal — Amplify section)
# LINKTREE_API_KEY lives in Google Secret Manager only (used server-side by the
# `linktreeProxy` Cloud Function). Set with:
#   firebase functions:secrets:set LINKTREE_API_KEY
# Never add VITE_LINKTREE_* vars.

# Klaviyo (newsletter / mailing list)
# Both secrets live in Google Secret Manager only (used server-side by the
# `klaviyoProxy` and public `newsletterSubscribe` Cloud Functions). Set with:
#   firebase functions:secrets:set KLAVIYO_PRIVATE_KEY
#   firebase functions:secrets:set KLAVIYO_LIST_ID
# KLAVIYO_LIST_ID is the Klaviyo list that public newsletter signups join.
# Never add VITE_KLAVIYO_* vars.
