rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user is an approved admin.
    // Uses Firebase Auth Custom Claims set server-side via admin SDK — never
    // reads from a client-writable Firestore document (OWASP A01:2021 / FINDING-03).
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.adminRole != null &&
             request.auth.token.adminRole != '';
    }

    // Default deny — no catch-all grants; every collection must be explicitly listed.
    // Removing the isServiceAccount() catch-all that granted full DB read/write to
    // any custom-token holder (CRITICAL: FINDING-03).
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicitly deny client access to the /admins/ collection.
    // Admin registry is read/written exclusively by Cloud Functions via admin SDK.
    match /admins/{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Wiki Pages — admin write only (content is CMS-managed)
    match /wiki_pages/{pageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Social Media Module

    // Social Media Module — admin-managed content; write restricted to admins.
    // These collections contain scheduled posts, libraries, and calendar slots
    // that should only be modified by the CMS admin portal.

    // Workspaces
    match /social_workspaces/{workspaceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Posts (One-off scheduled posts)
    match /social_posts/{postId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Libraries (Evergreen containers)
    match /social_libraries/{libId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Library Items (The actual content templates)
    match /social_library_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Schedule Slots (The recurring plan)
    match /social_schedule_slots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Analytics/Stats (aggregated)
    match /social_analytics/{statId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend writes stats
    }

    // Blog Posts Collection
    match /blogs/{blogId} {
      allow read: if true; // Public read for blog content
      allow create, update, delete: if isAdmin(); // Only approved admins can modify
    }

    // YouTube Videos Collection
    match /youtubevideos/{videoId} {
      allow read: if true; // Public read for video metadata
      allow create, update, delete: if isAdmin(); // Only approved admins can modify
    }

    // Podcast Episodes Collection
    match /podcasts/{episodeId} {
      allow read: if true; // Public read for podcast content
      allow create, update, delete: if isAdmin(); // Only approved admins can modify
    }

    // Certifications Collection - Public Read
    match /certifications/{certId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin integration settings (e.g. Sessionize speaker ID) — admin only.
    // Edited from the admin Connections page; read by admin pages.
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Speaker Events Collection - Public Read
    match /speakerevents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Episodes Collection - Public Read
    match /episodes/{episodeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Framework Collections - Public Read
    match /frameworks/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /pillar_details/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /pillar_items/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Architecture Designs - Public Read
    match /designs/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // ContentForge (Phase 1) - New Collections
    // ========================================================================

    // Helper functions for ContentForge
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function canEditPage(data) {
      return isAuthenticated() && isOwner(data.createdBy);
    }

    // Content Pages Collection
    match /content/pages/{pageId} {
      // Read: Authenticated OR published status
      allow read: if
        isAuthenticated() ||
        resource.data.status == 'published';

      // Create: Must be authenticated, start as draft/backlog
      allow create: if
        isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.slug != null &&
        request.resource.data.title != null &&
        request.resource.data.status in ['draft', 'backlog'];

      // Update: Only creator can edit
      allow update: if
        isAuthenticated() &&
        canEditPage(resource.data) &&
        request.resource.data.status in ['draft', 'backlog', 'scheduled', 'archived', 'trash'] &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;

      // Delete: Only soft delete (set status='trash')
      allow delete: if false;

      // Versions Subcollection
      match /versions/{versionId} {
        allow read: if isAuthenticated();
        allow write: if false; // Cloud Functions only
      }

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if
          isAuthenticated() &&
          request.resource.data.author == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.content != null;
        allow update: if
          isAuthenticated() &&
          isOwner(resource.data.author);
        allow delete: if
          isAuthenticated() &&
          isOwner(resource.data.author);
      }
    }

    // Config Collections (Read-only for frontend)
    match /config/providers/{providerId} {
      allow read: if true; // Public
      allow write: if false; // Cloud Functions only
    }

    match /config/tags/{tagId} {
      allow read: if true; // Public
      allow write: if false; // Cloud Functions only
    }

    match /config/settings/{settingId} {
      allow read: if true; // Public
      allow write: if false; // Cloud Functions only
    }

    // ========================================================================
    // News & Content Pipeline Collections
    // ========================================================================

    // Content Queue Collection (ContentForge Admin Workflow)
    match /content/{contentId} {
      // Authenticated users can read (admin queue access)
      allow read: if isAuthenticated();
      
      // Only approved admins can write from the client.
      allow create, update: if isAdmin();
      
      // No direct deletes (soft delete via status updates)
      allow delete: if false;
    }

    // RSS Cache Collection - Public read, Cloud Functions write only
    match /rss_cache/{cacheId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // AI Insights Collection - Public read, Cloud Functions write only
    match /ai_insights/{insightId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // Audits Collection (Logged-in users only)
    match /audits/{auditId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // Image Prompts Collection - Admin management
    // Structure: image_prompts/{pageDocId}/sets/{promptSetName}
    match /image_prompts/{pageDocId} {
      allow read: if true; // Public read for prompt configuration
      allow write: if isAdmin();
      match /sets/{promptSetName} {
        allow read: if true; // Public read for prompt sets
        allow write: if isAdmin();
      }
    }

    // Global image prompt library
    // Structure: image_prompt_sets/{setName}/prompts/{promptName}
    match /image_prompt_sets/{setName} {
      allow read: if true;
      allow write: if isAdmin();

      match /prompts/{promptName} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Per-page assignment for the active prompt set / prompt name
    // Structure: image_prompt_pages/{pageDocId}
    match /image_prompt_pages/{pageDocId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Curated Article Images Collection - Cache for generated images
    // Structure: curated_article_images/{articleId}
    match /curated_article_images/{articleId} {
      allow read: if true;
      allow create: if false; // Cloud Functions only
      allow update: if isAdmin();
      allow delete: if false; // Cloud Functions only
    }

    // ContentForge generated image history shown in admin gallery
    match /generated_content_images/{imageId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false; // Deletes still go through backend cleanup
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cert Events Collection - written by scrapeSkillsHubRss Cloud Function
    // Public read so the frontend timeline can render without auth
    match /certEvents/{eventId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // Public snapshot documents — written exclusively by the publishSnapshot
    // Cloud Function; read by the About page and speaking-events widget so
    // visitors can see new content without a full site redeploy.
    match /_snapshots/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // System Collection
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // ── AI Engine ──────────────────────────────────────────────────────────────
    // ai_providers — admin-managed list of AI service configs (no API keys stored here)
    match /ai_providers/{providerId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Admin page uses soft-delete; hard delete via Cloud Functions only
    }

    // mcp_servers — admin-managed list of MCP server configs
    match /mcp_servers/{serverId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin(); // Allow deleting custom servers from UI
    }

    // ai_usage — written by Cloud Functions (aiProxy); admin read-only
    match /ai_usage/{usageId} {
      allow read:  if isAdmin();
      allow write: if false; // Cloud Functions only — never written from the browser
    }

    // recordings — written by admin portal (Plaud integration)
    match /recordings/{recordingId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Soft delete only via status field
    }

    // ── Labs Platform ──────────────────────────────────────────────────────────
    // lab_jobs — job queue for the VPS lab agent. Written only via the Admin SDK
    // (enqueueLabJob/cancelLabJob Cloud Functions + the VPS agent's service
    // account). Admin clients subscribe read-only for live status/output.
    match /lab_jobs/{jobId} {
      allow read:  if isAdmin();
      allow write: if false; // Cloud Functions / agent (Admin SDK) only
    }

    // lab_agents — heartbeat docs written by the VPS agent via the Admin SDK.
    match /lab_agents/{agentId} {
      allow read:  if isAdmin();
      allow write: if false; // Agent service account (Admin SDK) only
    }
  }
}
