# =============================================================================
# terraform.tfvars.example — DO NOT commit real values
# Copy to terraform.tfvars for local runs (never commit that file)
#
# For TF Cloud runs: all values are set as workspace variables
# Org: HybridCloudWorks | Workspace: hybridcloudworks-infra
# =============================================================================

# Hostinger
hostinger_api_token = "your-hostinger-api-token"
vps_id              = "939861"
vps_ipv4            = "your-vps-public-ip"
ssh_public_key      = "ssh-ed25519 AAAA... your-key"

# Cloudflare
cloudflare_api_token = "your-cloudflare-api-token"
cloudflare_zone_id   = "your-32-char-zone-id"

# Domain (default: hybridcloudworks.com)
# domain = "hybridcloudworks.com"
