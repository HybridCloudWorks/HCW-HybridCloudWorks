# ============================================================================
# HCW Secrets - Terraform Variables Template
# ============================================================================
# Copy this file to secrets.auto.tfvars and fill in values.
# DO NOT commit secrets.auto.tfvars to version control!
# ============================================================================

# GCP Project
project_id = "your-gcp-project-id"
region     = "us-central1"

# Infrastructure secrets
cloudflare_api_token   = "your-cloudflare-api-token"
db_password            = "your-database-password"
n8n_encryption_key     = "generate-with-openssl-rand-hex-32"
n8n_admin_password     = "your-n8n-admin-password"
grafana_admin_password = "your-grafana-admin-password"

# AI API Keys (optional - leave empty if not using)
openai_api_key     = ""
perplexity_api_key = ""
anthropic_api_key  = ""
